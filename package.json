{
  "name": "interactive-desktop-wallpaper",
  "version": "1.1.0",
  "description": "互动 3D 桌面壁纸 — 基于 Pixi.js + Electron 的伪 3D 深度视差壁纸",
  "main": "main.js",
  "author": "ZihengMiao",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win nsis",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "electron-log": "^5.0.1",
    "onnxruntime-node": "1.31.1",
    "pixi.js": "7.4.2"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.wallpaper.interactive-3d",
    "productName": "互动3D壁纸",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "settings.html",
      "style.css",
      "src/**/*",
      "renderer/**/*",
      "settings/**/*",
      "shared/**/*",
      "ui/**/*",
      "assets/**/*",
      "background.png",
      "depth_map.png",
      "!node_modules/onnxruntime-node/bin/napi-v*/{darwin,linux}/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/x64/{DirectML,dxcompiler}.dll",
      "!node_modules/onnxruntime-node/script/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**"
    ],
    "extraResources": [
      {
        "from": "overlay",
        "to": "overlay"
      },
      {
        "from": "elements",
        "to": "elements",
        "filter": [
          "manifest.json",
          "*_cut.mp4",
          "*_thumb.jpg"
        ]
      },
      {
        "from": "wallpapers",
        "to": "wallpapers"
      },
      {
        "from": "depth_anything_v2_small_ir9.onnx",
        "to": "models/depth_anything_v2_small.onnx"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "Interactive3DWallpaper-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
